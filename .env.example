# Application Port
PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cloudboard
DB_SSLMODE=disable

# Authentication
JWT_SECRET=supersecret-change-me-in-production

# Storage Backend (local | s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads

# AWS / S3 (used if STORAGE_BACKEND=s3)
AWS_REGION=us-east-1
S3_BUCKET=cloudboard-profile-images-change-me
